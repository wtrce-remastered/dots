#!/usr/bin/env bash

if [[ $# -eq 1 ]]; then
    selected=$1
else
    mapfile -t lines < "$HOME/.config/tmuxs"
    selected_dirs=()

    for line in "${lines[@]}"; do
        [[ -z "$line" ]] && continue
        line="${line/#\~/$HOME}"
        if [[ "$line" == */ ]]; then
            while IFS= read -r d; do
                selected_dirs+=("$d")
            done < <(find "$line" -mindepth 1 -maxdepth 1 -type d)
        else
            selected_dirs+=("$line")
        fi
    done

    selected=$(printf '%s\n' "${selected_dirs[@]}" | fzf)
fi

if [[ -z $selected ]]; then
    exit 0
fi

selected="${selected/#\~/$HOME}"
if [[ ! -d "$selected" ]]; then
    echo "Error: '$selected' is not a directory" >&2
    exit 1
fi
selected=$(CDPATH= cd -- "$selected" && pwd) || exit 1

selected_name=$(basename "$selected" | tr . _)

if ! tmux has-session -t "=$selected_name" 2> /dev/null; then
    tmux new-session -ds "$selected_name" -n "$selected_name" -c "$selected"
fi

if [[ -z $TMUX ]]; then
    tmux attach -t "=$selected_name"
else
    tmux switch-client -t "=$selected_name"
fi
