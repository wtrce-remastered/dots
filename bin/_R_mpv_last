#!/usr/bin/python3
"""Open the last media content file in the current directory in mpv.

Matches mpv's natural sorting order (misc/natural_sort.c / strnatcasecmp) and
default media extension lists, opening only the single last matching file
(not a playlist).
"""

from __future__ import annotations

import argparse
import functools
import os
import shutil
import sys
from pathlib import Path

MPV_BIN = os.environ.get("MPV_BIN", "mpv")

# Standard mpv default extension sets (see `mpv --help=video-exts`, etc.)
VIDEO_EXTS = frozenset(
    {
        "3g2",
        "3gp",
        "avi",
        "flv",
        "m2ts",
        "m4v",
        "mj2",
        "mkv",
        "mov",
        "mp4",
        "mpeg",
        "mpg",
        "ogv",
        "rmvb",
        "ts",
        "webm",
        "wmv",
        "y4m",
    }
)

AUDIO_EXTS = frozenset(
    {
        "aac",
        "ac3",
        "aiff",
        "ape",
        "au",
        "dts",
        "eac3",
        "flac",
        "m4a",
        "mka",
        "mp3",
        "oga",
        "ogg",
        "ogm",
        "opus",
        "thd",
        "wav",
        "wma",
        "wv",
    }
)

IMAGE_EXTS = frozenset(
    {
        "avif",
        "bmp",
        "gif",
        "j2k",
        "jp2",
        "jpeg",
        "jpg",
        "jxl",
        "png",
        "svg",
        "tga",
        "tif",
        "tiff",
        "webp",
    }
)

TYPE_MAP: dict[str, frozenset[str]] = {
    "video": VIDEO_EXTS,
    "audio": AUDIO_EXTS,
    "image": IMAGE_EXTS,
}


def _is_ascii_digit(ch: str) -> bool:
    return "0" <= ch <= "9"


def _is_ascii_space(ch: str) -> bool:
    return ch in " \t\n\r\f\v"


def _compare_right(a: str, ai: int, b: str, bi: int) -> int:
    """Compare two digit runs by numeric magnitude (mpv misc/natural_sort.c)."""
    bias = 0
    la, lb = len(a), len(b)
    while True:
        ca = a[ai] if ai < la else ""
        cb = b[bi] if bi < lb else ""
        da = _is_ascii_digit(ca)
        db = _is_ascii_digit(cb)
        if not da and not db:
            return bias
        if not da:
            return -1
        if not db:
            return 1
        if ca < cb:
            if bias == 0:
                bias = -1
        elif ca > cb:
            if bias == 0:
                bias = 1
        ai += 1
        bi += 1


def _compare_left(a: str, ai: int, b: str, bi: int) -> int:
    """Compare two leading-zero digit runs left-to-right (mpv misc/natural_sort.c)."""
    la, lb = len(a), len(b)
    while True:
        ca = a[ai] if ai < la else ""
        cb = b[bi] if bi < lb else ""
        da = _is_ascii_digit(ca)
        db = _is_ascii_digit(cb)
        if not da and not db:
            return 0
        if not da:
            return -1
        if not db:
            return 1
        if ca < cb:
            return -1
        if ca > cb:
            return 1
        ai += 1
        bi += 1


def mp_natural_sort_cmp(a: str, b: str) -> int:
    """Port of mpv's mp_natural_sort_cmp (case-insensitive natural sort + tiebreaker)."""
    ai = 0
    bi = 0
    la, lb = len(a), len(b)

    while True:
        while ai < la and _is_ascii_space(a[ai]):
            ai += 1
        while bi < lb and _is_ascii_space(b[bi]):
            bi += 1

        ca = a[ai] if ai < la else ""
        cb = b[bi] if bi < lb else ""

        if ca and cb and _is_ascii_digit(ca) and _is_ascii_digit(cb):
            fractional = ca == "0" or cb == "0"
            res = _compare_left(a, ai, b, bi) if fractional else _compare_right(a, ai, b, bi)
            if res != 0:
                return res

        if not ca and not cb:
            # Deterministic tiebreaker matching byte order if naturally equal.
            if a < b:
                return -1
            if a > b:
                return 1
            return 0

        la_ch = ca.lower()
        lb_ch = cb.lower()
        if la_ch < lb_ch:
            return -1
        if la_ch > lb_ch:
            return 1

        ai += 1
        bi += 1


def resolve_extensions(types_spec: str) -> set[str] | None:
    """Resolve comma-separated type filter ('video,audio', 'all', etc.) to extensions.

    Returns None when all non-hidden files should be accepted.
    """
    parts = [p.strip().lower() for p in types_spec.split(",") if p.strip()]
    if not parts or "all" in parts:
        return None
    exts: set[str] = set()
    for part in parts:
        if part not in TYPE_MAP:
            valid = ", ".join((*TYPE_MAP.keys(), "all"))
            raise ValueError(f"Unknown media type {part!r}. Valid options: {valid}")
        exts.update(TYPE_MAP[part])
    return exts


def find_last_content_file(directory: Path, allowed_exts: set[str] | None) -> Path | None:
    """Return the last content file in directory using mpv's natural sort order."""
    candidates: list[str] = []
    with os.scandir(directory) as entries:
        for entry in entries:
            name = entry.name
            if name.startswith("."):
                continue
            try:
                if not entry.is_file(follow_symlinks=True):
                    continue
            except OSError:
                continue

            if allowed_exts is not None:
                ext = Path(name).suffix.lstrip(".").lower()
                if ext not in allowed_exts:
                    continue

            candidates.append(name)

    if not candidates:
        return None

    candidates.sort(key=functools.cmp_to_key(mp_natural_sort_cmp))
    return directory / candidates[-1]


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Open the last content file in a directory in mpv (using mpv's natural sort order).",
        epilog="Pass extra flags to mpv after '--', e.g.: mpv-last.py -- --fullscreen --speed=1.5",
    )
    parser.add_argument(
        "directory",
        nargs="?",
        type=Path,
        default=Path.cwd(),
        help="Directory to scan (default: current working directory).",
    )
    filter_group = parser.add_mutually_exclusive_group()
    filter_group.add_argument(
        "--video-only",
        action="store_true",
        help="Only consider video files.",
    )
    filter_group.add_argument(
        "--audio-only",
        action="store_true",
        help="Only consider audio files.",
    )
    filter_group.add_argument(
        "--types",
        default="video,audio",
        help="Comma-separated media types: video, audio, image, or all (default: video,audio).",
    )
    parser.add_argument(
        "-p",
        "--print",
        dest="print_only",
        action="store_true",
        help="Print the selected file path instead of launching mpv.",
    )
    parser.add_argument(
        "mpv_args",
        nargs=argparse.REMAINDER,
        help="Optional extra arguments forwarded to mpv (prefix with '--').",
    )
    args = parser.parse_args(argv)
    if args.mpv_args and args.mpv_args[0] == "--":
        args.mpv_args = args.mpv_args[1:]
    return args


def main(argv: list[str] | None = None) -> int:
    # Support `mpv-last.py -- --fullscreen` without treating `--` as the directory arg.
    raw_argv = list(sys.argv[1:] if argv is None else argv)
    mpv_args: list[str] = []
    if "--" in raw_argv:
        sep = raw_argv.index("--")
        mpv_args = raw_argv[sep + 1 :]
        raw_argv = raw_argv[:sep]

    args = parse_args(raw_argv)
    if args.mpv_args:
        mpv_args = args.mpv_args + mpv_args

    directory = args.directory
    if not directory.is_dir():
        print(f"Not a directory: {directory}", file=sys.stderr)
        return 1

    if args.video_only:
        types_spec = "video"
    elif args.audio_only:
        types_spec = "audio"
    else:
        types_spec = args.types

    try:
        allowed_exts = resolve_extensions(types_spec)
        last_file = find_last_content_file(directory, allowed_exts)
    except (ValueError, OSError) as exc:
        print(str(exc), file=sys.stderr)
        return 1

    if last_file is None:
        print(f"No matching media files found in {directory}", file=sys.stderr)
        return 1

    if args.print_only:
        print(last_file)
        return 0

    mpv_path = shutil.which(MPV_BIN)
    if not mpv_path:
        print(f"'{MPV_BIN}' not found in PATH.", file=sys.stderr)
        return 1

    os.execvp(mpv_path, [mpv_path, *mpv_args, "--", str(last_file)])
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
